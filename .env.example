# REALIZE OS 教育コンテンツMASTER - Supabase migration placeholders (unused in MVP)
#
# The MVP stores all data in the browser's localStorage only.
# These values are only needed later when switching to SupabaseContentRepository.
# Creating a .env file does NOT make this app connect to Supabase automatically;
# that switch requires explicit user approval.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
